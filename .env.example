# Copy this file to .env (which is gitignored) and fill in the real values.
# Never commit .env to version control.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=did_user
POSTGRES_PASSWORD=changeme

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=did_user
RABBITMQ_PASSWORD=changeme

# ── JWT signing secret (≥32 chars, high-entropy string) ──────────────────────
JWT_SECRET=changeme-replace-with-32+-char-secret

# ── Ethereum signer key for on-chain writes ───────────────────────────────────
# For local Anvil dev use the well-known account #0 key below.
# For production use a key whose address holds sufficient ETH and is not reused.
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
